{
  "name": "as-compatible-copilot",
  "displayName": "AS Provider for Copilot",
  "description": "BYOK Copilot LLM provider backed by Vercel AI SDK.",
  "version": "1.0.4",
  "publisher": "Q78KG",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoshino-Yumetsuki/as-compatible-copilot.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "enabledApiProposals": [
    "chatProvider",
    "languageModelSystem"
  ],
  "keywords": [
    "ai",
    "chat",
    "copilot",
    "github-copilot",
    "language-model",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "openai-compatible",
    "openai-responses",
    "thinking"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "type": "commonjs",
  "icon": "icon.png",
  "files": [
    "dist/extension.cjs",
    "static/assets/configView",
    "icon.png",
    "LICENSE"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "as-compatible-copilot",
        "displayName": "AS Provider for Copilot"
      }
    ],
    "commands": [
      {
        "command": "asCompatibleCopilot.setApiKey",
        "title": "AS Provider for Copilot: Set API Key"
      },
      {
        "command": "asCompatibleCopilot.deleteConfigured",
        "title": "AS Provider for Copilot: Delete Configured Entry"
      },
      {
        "command": "asCompatibleCopilot.refreshModels",
        "title": "AS Provider for Copilot: Refresh Discovered Models"
      },
      {
        "command": "asCompatibleCopilot.openConfiguration",
        "title": "AS Provider for Copilot: Open Configuration"
      }
    ]
  },
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "clean": "rimraf dist",
    "bundle": "rolldown -c rolldown.config.mjs",
    "build:webview": "vite build",
    "build:vsce": "node --run build && vsce package --no-yarn",
    "bundle:test": "rolldown -c rolldown.test.config.mjs",
    "build": "node --run clean && node --run build:webview && node --run bundle",
    "test": "node --run clean && node --run lint && node --run bundle:test && node --test dist/test/*.test.js",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "ai": "^7.0.152",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vscode/vsce": "^4.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
