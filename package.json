{
  "name": "as-compatible-copilot",
  "displayName": "AS Compatible Provider for Copilot",
  "description": "Copilot LLM provider backed by Vercel AI SDK.",
  "version": "1.0.0",
  "publisher": "Q78KG",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoshino-Yumetsuki/as-compatible-copilot.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.126.0"
  },
  "enabledApiProposals": [
    "chatProvider",
    "languageModelSystem"
  ],
  "keywords": [
    "ai",
    "chat",
    "copilot",
    "github-copilot",
    "language-model",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "openai-compatible",
    "openai-responses",
    "thinking"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "type": "commonjs",
  "files": [
    "dist/extension.cjs",
    "static/assets/configView",
    "LICENSE"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "as-compatible-copilot",
        "displayName": "AS Compatible Provider for Copilot"
      }
    ],
    "commands": [
      {
        "command": "asCompatibleCopilot.setApiKey",
        "title": "AS Compatible Provider for Copilot: Set API Key"
      },
      {
        "command": "asCompatibleCopilot.deleteConfigured",
        "title": "AS Compatible Provider for Copilot: Delete Configured Entry"
      },
      {
        "command": "asCompatibleCopilot.refreshModels",
        "title": "AS Compatible Provider for Copilot: Refresh Discovered Models"
      },
      {
        "command": "asCompatibleCopilot.openConfiguration",
        "title": "AS Compatible Provider for Copilot: Open Configuration"
      }
    ]
  },
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "clean": "rimraf dist",
    "bundle": "rolldown -c rolldown.config.mjs",
    "build:webview": "vite build",
    "build:vsce": "node --run build && vsce package --no-yarn",
    "bundle:test": "rolldown -c rolldown.test.config.mjs",
    "build": "node --run clean && node --run build:webview && node --run bundle",
    "test": "node --run clean && node --run lint && node --run bundle:test && node --test dist/test/*.test.js",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.25",
    "@ai-sdk/google": "^4.0.29",
    "@ai-sdk/openai": "^4.0.25",
    "@ai-sdk/openai-compatible": "^3.0.18",
    "ai": "^7.0.44",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vscode/vsce": "^3.9.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
